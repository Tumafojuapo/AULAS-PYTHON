# ABAIXO ESTOU CRIANDO UMA JANELA COM A FRASE OLA GALERA, CENTRALIZADA NO EIXO X E NO EIXO Y


from kivy.app import App
from kivy.uix.label import Label

class MainApp(App):
  def build(self):
    label = Label(text='Ola galera',
                  size_hint=(.5,.5),
                  pos_hint ={'cente_x':.5,'center_y':.5})
    return label

if __name__ == '__main__':
  app = MainApp()
  app.run()
